# Configuration de KDL Cyclone — valeurs d'exemple, à adapter.
#
# L'application démarre sans aucune configuration : ces variables ne servent
# qu'à surcharger les valeurs par défaut. Aucune clé d'API n'est nécessaire,
# toutes les sources utilisées sont ouvertes et anonymes — c'est un choix de
# conception, pas un oubli.

# Port d'écoute local.
KDL_CYCLONE_PORT=4240

# Interface d'écoute. Laisser 127.0.0.1 : la publication passe par un reverse
# proxy, jamais par une écoute directe sur toutes les interfaces.
KDL_CYCLONE_HOST=127.0.0.1

# Dossier où sont écrites les données collectées et l'état de l'application.
# Il est recréé au besoin ; ne le versionnez pas.
KDL_CYCLONE_DATA=./data
